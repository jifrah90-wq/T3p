# Copy to .env and fill in. NEVER commit the real file.
#
# HL_SECRET_KEY must be an API wallet private key, generated at
# app.hyperliquid.xyz -> More -> API. Do NOT use your main wallet's seed
# phrase or a key that can withdraw funds. An API wallet can trade but
# cannot move money off the exchange, which is exactly what a bot needs.
HL_SECRET_KEY=0x...

# Your main Hyperliquid account address (the one that holds the funds).
HL_ACCOUNT_ADDRESS=0x...

# mainnet or testnet. Leave unset to use the value in config/default.yaml.
HL_NETWORK=testnet

# Set to 1 to arm live trading. Absent or 0 keeps everything in paper mode.
HL_LIVE=0
